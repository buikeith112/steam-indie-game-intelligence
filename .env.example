# Copy to .env and fill in. Never commit .env.

# Free key from https://steamcommunity.com/dev/apikey (needed for IStoreService/GetAppList, IStoreBrowseService/GetItems)
STEAM_API_KEY=

# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://steam:steam@localhost:5432/steam_intel

# Optional: IsThereAnyDeal key for historical price backfill (https://isthereanydeal.com/apps/my/)
ITAD_API_KEY=

# Requests per second budgets (tune after measuring real limits)
STORE_RPS=0.7
STEAMSPY_RPS=1.0
WEBAPI_RPS=2.0

# Store raw review text in core.reviews (large); false keeps only metadata
STORE_REVIEW_TEXT=false

# Analytical scope
MIN_RELEASE_YEAR=2018
MIN_REVIEWS=10
